{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ]; then sh \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/gate_run.py\" prompt; fi",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ]; then sh \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/resume_run.py\" --hook prompt; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ]; then sh \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/gate_run.py\" tool; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ]; then sh \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/gate_run.py\" post; fi",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ]; then sh \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/resume_run.py\" --hook post; fi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ]; then sh \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/gate_run.py\" post; fi",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ]; then sh \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/gate_run.py\" post; fi",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ]; then sh \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/gate_run.py\" stop; fi",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ]; then sh \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/resume_run.py\" --hook stop; fi",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
