{
  "_note": "Capacity and diary hook registrations, held back from hooks.json and codex.json until native lifecycle qualification passes (docs/approval-gate.md). To try them, add these events to the manifest for your host and widen its PreToolUse matcher to `.*` so assignment tools are checked.",
  "PreToolUse_matcher": ".*",
  "hooks.json": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ]; then sh \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/gate_run.py\" SessionStart; fi",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ]; then sh \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/gate_run.py\" SubagentStart; fi",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ]; then sh \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/gate_run.py\" SubagentStop; fi",
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ]; then sh \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/gate_run.py\" PreCompact; fi",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ]; then sh \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/gate_run.py\" SessionEnd; fi",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "codex.json": {
