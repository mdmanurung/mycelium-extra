+
+import math
+import os
+
+ROOT = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", ".."))
+DE = os.path.join(ROOT, "analysis", "vaccine-response", "outputs", "de_results.tsv")
