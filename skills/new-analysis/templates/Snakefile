"""@@NAME@@: run the numbered steps in order.

From this folder: bash run.sh   (runs this file, then logs what changed to logs/CHANGES.md)
Without run.sh:   snakemake -s @@DEST@@/Snakefile --cores 4
One step:         add the rule name, e.g. step01_prepare
Interpreters:     @@ENV_NOTE@@; override with --config rscript=/path/to/Rscript python=/path/to/python jupyter=/path/to/jupyter quarto=/path/to/quarto

Step scripts live in code/; paths are relative to this folder. Each step owns outputs/<step>/: its outputs,
executed notebook and qmd page go there, its logs and benchmark under outputs/<step>/logs/. A rerun
overwrites that folder; old outputs are not kept. Wrap an output in protected() once it is expensive to recompute.
"""

workdir: workflow.basedir

RSCRIPT = config.get("rscript", @@RSCRIPT@@)
PYTHON = config.get("python", @@PYTHON@@)
JUPYTER = config.get("jupyter", @@JUPYTER@@)
QUARTO = config.get("quarto", "quarto")
THREADS = "OPENBLAS_NUM_THREADS={threads} OMP_NUM_THREADS={threads} MKL_NUM_THREADS={threads} "


def every_step_output(wildcards):
    # Resolved when Snakemake builds the plan, so every rule below is known by then.
    return [out for r in workflow.rules if r.name != "all" for out in r.output]


# Target: the last step's outputs, plus the outputs of every step. With the last step alone, Snakemake
# reports "Nothing to be done" after a step failed, whenever the later steps still have their old outputs,
# and run.sh would then exit 0 with that step's outputs missing.
rule all:
    input:
@@LAST_OUTPUTS@@
        every_step_output,


@@RULES@@
